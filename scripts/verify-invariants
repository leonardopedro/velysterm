#!/usr/bin/env bash
# H1 verify-invariants gate (velysterm).
#
# Turns the AGENTS.md maintenance checklist into machine-checkable invariants
# owned by THIS repo: the unfer_agent op census (must not drift from
# unfer_protocol::ops::AGENT_OPS) and the PropKind/SemanticIndex kernel surface.

set -u
FAILED=0
PASSED=0
GAPS=0

check() {
    local name="$1"
    shift
    if "$@"; then
        echo "[pass] $name"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] $name"
        FAILED=$((FAILED + 1))
    fi
}

gap() {
    echo "[gap]  $1"
    GAPS=$((GAPS + 1))
}

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
unfer_root="${UNFER_ROOT:-$repo_root/../unfer}"

# --- H1.17 unfer_agent op census is generated from AGENT_OPS, never local ---
check "C: VALID_OPS sourced from unfer_protocol::ops::AGENT_OPS" \
    grep -q "unfer_protocol::ops::AGENT_OPS" "$repo_root/crates/kernel_client/src/bin/unfer_agent.rs"
check "C: unknown op falls back to UK-1001 + hint" \
    grep -q "UK-1001" "$repo_root/crates/kernel_client/src/bin/unfer_agent.rs"

# Op-count drift: the module doc header must not claim a stale count.
# (Counts entries in the AGENT_OPS array in the sibling unfer repo.)
actual_ops="$(
  sed -n '/pub const AGENT_OPS/,/];/p' "$unfer_root/unfer_protocol/src/ops.rs" \
  | grep -c '^    "[a-z_]*",$' || true
)"
if [ "$actual_ops" -gt 0 ]; then
    declared="$(grep -oE '[0-9]+-op' "$repo_root/crates/kernel_client/src/bin/unfer_agent.rs" | grep -oE '[0-9]+' | head -1)"
    if [ "$declared" = "$actual_ops" ]; then
        check "C: op-count header matches AGENT_OPS.len() ($actual_ops)" true
    else
        check "C: op-count header matches AGENT_OPS.len() ($actual_ops, header says $declared)" false
    fi
else
    gap "C: could not parse AGENT_OPS from $unfer_root (sibling unfer not path-dependency?)"
fi

# --- H1.18 PropKind kernel variants present and mapped ---
check "C: PropKind::Model kernel variant present" \
    grep -q "Model" "$repo_root/crates/mathed_core/src/markers.rs"
check "C: PropKind::is_kernel() distinguishes kernel from non-kernel" \
    grep -q "fn is_kernel" "$repo_root/crates/mathed_core/src/markers.rs"
check "C: KernelStatement carries kind + body_text" \
    grep -q "body_text" "$repo_root/crates/mathed_core/src/semantics.rs"

# --- H1.19 SemanticIndex collects kernel statements (index built, not stubbed) ---
check "C: SemanticIndex has kernel_statements collection" \
    grep -q "kernel_statements" "$repo_root/crates/mathed_core/src/semantics.rs"
check "C: build_index assembles KernelStatement entries" \
    grep -q "fn build_index" "$repo_root/crates/mathed_core/src/semantics.rs"

# --- T-series: template-language surface (T6, and full-vision maturity) ---
check "T: PropKind::is_template() exists" \
    grep -q "fn is_template" "$repo_root/crates/mathed_core/src/markers.rs"
check "T: DocumentContext is the document-as-data context" \
    grep -q "pub struct DocumentContext" "$repo_root/crates/mathed_core/src/semantics.rs"
check "T: --render-typst CLI mode" \
    grep -q -- "--render-typst" "$repo_root/crates/mathed_mini/src/bin/mathed_mini.rs"
check "T: PropKind::Base for \\base composition (T7)" \
    grep -q '"base" | "master" => Self::Base' "$repo_root/crates/mathed_core/src/markers.rs"
check "T: egison rule engine seam generalized (T8)" \
    grep -q "pub fn mathed_rules_engine" "$repo_root/crates/mathed_mini/src/export.rs"
check "T: builtin_template.typ filter helpers (T7)" \
    test -f "$repo_root/crates/mathed_mini/src/builtin_template.typ"
check "T: preview_template headless compose (T9)" \
    grep -q "pub fn preview_template" "$repo_root/crates/mathed_mini/src/export.rs"

# --- U-series: UTF-8/ASCII surface (U5, and full-vision maturity) ---
check "U: completion_at is the ASCII→Unicode completion seam" \
    grep -q "pub fn completion_at" "$repo_root/crates/mathed_core/src/completion.rs"
check "U: --export-ascii interchange projection" \
    grep -q -- "--export-ascii" "$repo_root/crates/mathed_mini/src/bin/mathed_mini.rs"
check "U: canonical tables.rs is the single mapping source (U7)" \
    test -f "$repo_root/crates/mathed_core/src/tables.rs"
check "U: grapheme clusters via unicode-segmentation (U6)" \
    grep -q "unicode-segmentation" "$repo_root/crates/mathed_core/Cargo.toml"
check "U: splice pipeline never splits a cluster (U8)" \
    grep -q "cluster boundary" "$repo_root/crates/mathed_core/src/transform.rs"

# --- N-series: document-computing surface (N6, and full-vision depth) ---
check "N: PropKind::Exec for scripted segments" \
    grep -q '"exec" => Self::Exec' "$repo_root/crates/mathed_core/src/markers.rs"
check "N: PropKind::Kernel for granted kernel segments (N11)" \
    grep -q '"kernel" => Self::Kernel' "$repo_root/crates/mathed_core/src/markers.rs"
check "N: KernelBridge::run_block (notebook run-cell)" \
    grep -q "pub fn run_block" "$repo_root/crates/mathed_mini/src/kernel_bridge.rs"
check "N: output_region module (block output regions)" \
    test -f "$repo_root/crates/mathed_mini/src/output_region.rs"
check "N: --with-outputs report export" \
    grep -q -- "--with-outputs" "$repo_root/crates/mathed_mini/src/bin/mathed_mini.rs"
check "N: exec op carries the additive stdin field (N7)" \
    grep -q "stdin: String" "$repo_root/crates/kernel_client/src/lib.rs"
check "N: --run-all headless record (N8)" \
    grep -q -- "--run-all" "$repo_root/crates/mathed_mini/src/bin/mathed_mini.rs"
check "N: --export-ipynb projection (N10)" \
    grep -q -- "--export-ipynb" "$repo_root/crates/mathed_mini/src/bin/mathed_mini.rs"
check "N: kernel_exec op + KernelExec request (N11)" \
    grep -q "KernelExec" "$repo_root/crates/kernel_client/src/lib.rs"
check "N: jupyter_stdio transport parser (N11)" \
    test -f "$repo_root/crates/kernel_client/src/jupyter_stdio.rs"
check "N: rows -> table region rendering (N9)" \
    grep -q "pub fn parse_rows" "$repo_root/crates/mathed_mini/src/output_region.rs"
check "N: ctx.exec feeds templates (N9)" \
    grep -q 'ctx.exec' "$repo_root/crates/mathed_mini/src/export.rs"

# --- H12: agent notes (four implemented categories) ---
check "H12: notes implemented dir has the four categories" \
    test -d "$repo_root/.agents/notes/implemented/architecture" \
    && test -d "$repo_root/.agents/notes/implemented/feature" \
    && test -d "$repo_root/.agents/notes/implemented/testing" \
    && test -d "$repo_root/.agents/notes/implemented/process"

echo
echo "verify-invariants: $PASSED passed, $GAPS explained gap(s), $FAILED failed"
if [ "$FAILED" -gt 0 ]; then
    exit 1
fi
exit 0