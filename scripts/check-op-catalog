#!/usr/bin/env python3
"""check-op-catalog — the unfer_agent op catalog must match the code.

Three artifacts describe the agent protocol and must agree:

  1. the registry — `AGENT_OPS` in ../unfer/unfer_protocol/src/ops.rs
     (the declared surface; drives the did-you-mean hints and allowlists);
  2. the dispatch — the op match in crates/kernel_client/src/bin/
     unfer_agent.rs (the implemented surface);
  3. the catalog  — docs/AGENT_OP_CATALOG.md (the human surface).

All three drifted apart before: `agent_dm_read` shipped dispatched and
tested but unregistered, so the hint never advertised it. This gate keeps
them honest in both directions (registry <-> dispatch) and treats the
catalog as a *generated artifact that is verified*, not hand-written
(pattern adapted from REA's generated tool catalogs).

Usage:
    python3 scripts/check-op-catalog           # check everything
    python3 scripts/check-op-catalog --write   # regenerate the catalog

Exit status: 0 in sync, 1 drift (each drifted name printed), 2 setup error.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WORKSPACE = ROOT.parent
REGISTRY = WORKSPACE / "unfer" / "unfer_protocol" / "src" / "ops.rs"
DISPATCH = ROOT / "crates" / "kernel_client" / "src" / "bin" / "unfer_agent.rs"
CATALOG = ROOT / "docs" / "AGENT_OP_CATALOG.md"

BANNER = """<!-- GENERATED by scripts/check-op-catalog --write.
     Do not edit by hand: edit ../unfer/unfer_protocol/src/ops.rs (the
     registry) or the dispatch table, then regenerate. The gate fails if
     this file does not match a fresh generation byte for byte. -->

# unfer_agent op catalog

The agent protocol's declared surface (`AGENT_OPS`) grouped by the
registry's own section comments. A client sends `{"id", "op", "params"}`;
every op answers `{"id", "ok", "result" | "error"}`. An unregistered op
fails validation with a hint listing the names below.

Source of truth: `unfer/unfer_protocol/src/ops.rs`.
"""


def registry_entries() -> tuple[list[str], list[tuple[str, list[str]]]]:
    """Parse AGENT_OPS into (all names, [(group comment, names)])."""
    if not REGISTRY.is_file():
        raise SystemExit(f"check-op-catalog: missing {REGISTRY}")
    text = REGISTRY.read_text(encoding="utf-8")
    m = re.search(
        r"pub const AGENT_OPS: &\[&str\] = &\[(.*?)\n\];", text, re.S
    )
    if not m:
        raise SystemExit("check-op-catalog: AGENT_OPS const not found — pattern moved?")
    names: list[str] = []
    groups: list[tuple[str, list[str]]] = []
    comment: list[str] = []
    for line in m.group(1).splitlines():
        stripped = line.strip()
        if stripped.startswith("//"):
            comment.append(stripped.lstrip("/ ").strip())
            continue
        for name in re.findall(r'"([a-z][a-z0-9_]*)"', stripped):
            names.append(name)
            groups.append(("\n".join(comment).strip() or "ungrouped", [name]))
            comment = []
    # merge consecutive same-group entries
    merged: list[tuple[str, list[str]]] = []
    for group, entry in groups:
        if merged and merged[-1][0] == group:
            merged[-1][1].extend(entry)
        else:
            merged.append((group, list(entry)))
    return names, merged


def dispatch_ops() -> set[str]:
    """Ops with a dispatch arm in unfer_agent.rs.

    Arms look like `            "version" => ...`. The role parser
    (`parse_role`) has same-shaped arms for `implementer`/`integrator`/
    `reviewer` whose right side is `Some(Role::…)`, so those are excluded:
    they are values, not protocol ops.
    """
    if not DISPATCH.is_file():
        raise SystemExit(f"check-op-catalog: missing {DISPATCH}")
    ops: set[str] = set()
    for line in DISPATCH.read_text(encoding="utf-8").splitlines():
        m = re.match(r'^\s{8,16}"([a-z][a-z0-9_]*)" => (.*)$', line)
        if not m:
            continue
        rhs = m.group(2).lstrip()
        if rhs.startswith(("Some(", "None")):
            continue
        ops.add(m.group(1))
    return ops


def render(names: list[str], groups: list[tuple[str, list[str]]]) -> str:
    out = [BANNER, f"{len(names)} ops, grouped as the registry documents them.", ""]
    for comment, members in groups:
        title = comment.splitlines()[-1] if comment else "ungrouped"
        title = re.sub(r"[^A-Za-z0-9 ,.+()/`-]", "", title)[:80].strip() or "ungrouped"
        out.append(f"### {title}")
        out.append("")
        if comment and len(comment.splitlines()) > 1:
            out.append("> " + " ".join(comment.splitlines()))
            out.append("")
        for name in members:
            out.append(f"- `{name}`")
        out.append("")
    return "\n".join(out)


def prose_op_counts() -> list[tuple[str, int, str]]:
    """Hand-written `N ops` claims in the live prose surfaces.

    F4 (2026-10-13): AGENTS.md shipped "(36 ops …)" against a 61-op
    registry — the catalog gate verified registry<->dispatch<->catalog but
    nobody checked the *prose*, which is the number a new agent reads first.
    unfer's H1 gate already bans hand-maintained counts in
    EXPECTED_SYMBOLS.txt for exactly this reason; this applies the same
    doctrine to this repo's agent-facing prose.

    Scope is deliberately narrow: AGENTS.md and README.md are live surfaces
    whose counts a reader treats as current. Historical records (plan
    docs, CHANGELOG entries dated to their change) are period documents and
    stay untouched — a changelog that retroactively rewrites its own counts
    is worse than one that preserves them.
    """
    found: list[tuple[str, int, str]] = []
    for path in (ROOT / "AGENTS.md", ROOT / "README.md"):
        if not path.is_file():
            continue
        for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            for m in re.finditer(r"\b(\d+)\s+ops\b", line):
                found.append((str(path.relative_to(ROOT)), int(m.group(1)), f"line {lineno}"))
    return found


def main() -> int:
    names, groups = registry_entries()
    dispatch = dispatch_ops()
    if not names or not dispatch:
        print("check-op-catalog: empty extraction — a source pattern moved?", file=sys.stderr)
        return 2

    drift = False

    def report(label: str, items: set[str]) -> None:
        nonlocal drift
        if items:
            drift = True
            print(f"check-op-catalog: {label}: {', '.join(sorted(items))}")

    registry_set = set(names)
    report("registered in AGENT_OPS but no dispatch arm", registry_set - dispatch)
    report("dispatched but not registered in AGENT_OPS", dispatch - registry_set)
    report("AGENT_OPS contains duplicates",
           {n for n in names if names.count(n) > 1})

    # F4: prose counts must equal the registry, or not exist at all.
    for path, claimed, where in prose_op_counts():
        if claimed != len(names):
            drift = True
            print(
                f"check-op-catalog: {path} {where} says \"{claimed} ops\" but "
                f"AGENT_OPS has {len(names)} — drop the count from prose "
                f"(point at docs/AGENT_OP_CATALOG.md instead)"
            )

    expected = render(names, groups)
    if "--write" in sys.argv[1:]:
        CATALOG.parent.mkdir(parents=True, exist_ok=True)
        CATALOG.write_text(expected, encoding="utf-8")
        print(f"check-op-catalog: wrote {CATALOG.relative_to(ROOT)} ({len(names)} ops)")
        return 0 if not drift else 1

    if not CATALOG.is_file():
        print(f"check-op-catalog: {CATALOG} missing — run --write", file=sys.stderr)
        drift = True
    elif CATALOG.read_text(encoding="utf-8") != expected:
        drift = True
        print("check-op-catalog: docs/AGENT_OP_CATALOG.md is stale — run scripts/check-op-catalog --write")

    if drift:
        return 1
    print(
        f"check-op-catalog: in sync "
        f"({len(names)} registered ops, all dispatched, catalog fresh)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
