  let result = ()
  let inv_resolution = 1.0 / resolution

  for i in range(0, resolution + 1) {
    result.push((
      100% * i * inv_resolution,
      (func((time + PI * float(i) / resolution) * frequency) * amplitude) - 50%,
    ))
  }

  return result
}

#let main(
  animate,
) = {
  let amplitude = 10%
  let frequency = 1
  let resolution = 20
  let animate = animate * 2

